# ==============================================================================
# DevCollab Backend Environment Variables (.env.example)
# ==============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=info

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb://localhost:27017/devcollab

# JWT Authentication Secrets (Minimum 32 characters)
JWT_ACCESS_SECRET=your-secure-jwt-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret-at-least-32-chars-long

# CORS & Client Origins (comma-separated for multi-origin production setups)
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,https://your-app.vercel.app

# Cookie Strategy
# For free subdomains (Render backend + Vercel frontend), set COOKIE_SAMESITE=none
# For local development or custom shared domains, set COOKIE_SAMESITE=lax
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Reverse Proxy (Render / Vercel / Nginx hops behind load balancer)
TRUST_PROXY=1

# Public API URL (for OAuth callbacks & email links)
API_URL=http://localhost:5000

# OAuth Providers (Google & GitHub)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email Delivery (SMTP or console)
MAIL_TRANSPORT=console
SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM="DevCollab <noreply@devcollab.io>"

# AI Code Review (Optional)
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-sonnet-latest
AI_API_KEY=
AI_DAILY_REQUEST_LIMIT=20

# Error Tracking & Monitoring (Optional)
SENTRY_DSN=
METRICS_TOKEN=

# Scale-Out Redis (Optional, Stage 5)
REDIS_URL=

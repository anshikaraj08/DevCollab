# ==============================================================================
# DevCollab Frontend Environment Variables (.env.example)
# ==============================================================================

# Backend API URL (use https://your-backend.onrender.com for production)
VITE_API_URL=http://localhost:5000

# Error Tracking (Optional)
VITE_SENTRY_DSN=

# Monaco base path (optional). Leave empty: production builds use the self-hosted /monaco,
# development uses the CDN. The CSP blocks the CDN in production.
VITE_MONACO_BASE=


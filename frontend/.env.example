# ==============================================================================
# DevCollab Frontend Environment Variables (.env.example)
# ==============================================================================

# Backend API URL (use https://your-backend.onrender.com for production)
VITE_API_URL=http://localhost:5000

# Error Tracking (Optional)
VITE_SENTRY_DSN=

# Self-Hosted Monaco Base Path (Optional - defaults to CDN if empty)
VITE_MONACO_BASE=
